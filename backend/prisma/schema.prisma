datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  password            String
  name                String
  role                String         // "PATIENT", "DOCTOR", "PHARMACIST", "AUDITOR"
  licenseNumber       String?        // For doctors & pharmacists
  clinic              String?
  publicKey           String?        // Doctor RSA public key for signature verification
  privateKey          String?        // Doctor RSA private key (AES-256 encrypted at rest)
  ecdhPublicKey       String?        // secp256k1 ECDH public key for pairwise key agreement
  ecdhPrivateKey      String?        // secp256k1 ECDH private key (AES-256 encrypted at rest)
  failedLoginAttempts Int            @default(0) // Rate limiting / Brute force lockout counter
  lockedUntil         DateTime?      // Account lockout expiration timestamp
  createdAt           DateTime       @default(now())
  
  prescriptionsAuthored Prescription[] @relation("DoctorPrescriptions")
  prescriptionsReceived Prescription[] @relation("PatientPrescriptions")
  audits                PrescriptionAudit[]
}

model Prescription {
  id                   String              @id @default(uuid())
  patientId            String
  doctorId             String
  patientName          String
  doctorName           String
  clinicName           String
  dateIssued           String
  
  // Status state machine (Prevents Double-Fill Replay Attacks!)
  status               String              @default("ISSUED") // "ISSUED", "DISPENSED", "REVOKED"
  
  // Cryptographic Vault: AES-256-GCM Encrypted Payloads
  // Split encryption facilitates SELECTIVE DISCLOSURE (Zero-Knowledge Privacy)
  encryptedDiagnosis   String              // JSON { ciphertext, iv, authTag }
  encryptedMedications String              // JSON { ciphertext, iv, authTag }
  keyExchangeUsed      String?             // e.g. "ECDH-secp256k1" or "MASTER_KEY"
  
  // Tamper-Evident Integrity Fingerprint (SHA-256)
  dataHash             String              // SHA-256 of canonical prescription content
  
  // Cryptographic Signature of Doctor (RSA-2048)
  doctorSignature      String
  
  // Dispense tracking
  dispensedByPharmacist String?
  dispensedAt          DateTime?
  
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  
  doctor               User                @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  patient              User                @relation("PatientPrescriptions", fields: [patientId], references: [id])
  audits               PrescriptionAudit[]
}

model PrescriptionAudit {
  id             String       @id @default(uuid())
  prescriptionId String
  userId         String
  userRole       String
  action         String       // "VIEWED", "DISPENSED", "TAMPER_VERIFIED", "UNAUTHORIZED_ATTEMPT", "PRESCRIPTION_REVOKED"
  ipAddress      String
  userAgent      String?
  timestamp      DateTime     @default(now())
  entryHash      String?      // Blockchain-style cryptographic hash of this log entry
  previousHash   String?      // Pointer to previous audit log entry hash (hash chain)
  
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
}

model SecurityAlert {
  id             String       @id @default(uuid())
  severity       String       // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  type           String       // "RAPID_FILL_ATTEMPT", "DOUBLE_FILL_ATTACK", "TAMPER_DETECTED", "RATE_LIMIT_BURST", "BRUTE_FORCE_DETECTED", "REVOCATION_ALERT"
  details        String
  prescriptionId String?
  ipAddress      String
  userId         String?
  timestamp      DateTime     @default(now())
}

